@page "/"
@using bg_campaign_planner.Models
@using bg_campaign_planner.Services
@using bg_campaign_planner.Components
@inject CampaignDataService DataService
@inject PlannerCalculatorService CalculatorService
@inject IStringLocalizer<AppResources> Loc
@inject ILocalizationService LocService
@implements IDisposable

<PageTitle>@Loc.Get("App.BrowserTitle", CurrentGame?.Title ?? Loc["App.Title"])</PageTitle>

<div class="planner-app-container @ThemeClass">
    <div class="app-game-backdrop @(HasBackgroundImage ? "has-image" : "")" 
         style="@BackgroundImageStyle" 
         aria-hidden="true"></div>

    <!-- Top Header -->
    <header class="app-hero-header py-3 py-md-4">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-3">
                <LanguageSelector />
                <ThemeToggle />
            </div>
            <div class="text-center">
                <h1 class="display-5 fw-bold brand-title">@Loc["App.Subtitle"]</h1>
                <p class="lead text-muted-light mx-auto" style="max-width: 720px;">
                    @Loc["App.HeroLead"]
                </p>
            </div>
        </div>
    </header>

    @if (CurrentGame != null)
    {
        <div class="container main-content-container pb-5">
            <!-- 1. GAME SELECTION -->
            <section class="section-block">
                <div class="section-badge-title mb-3">
                    <span class="step-badge">@Loc.Get("App.StepBadge", 1)</span> @Loc["App.Step1Title"]
                </div>
                <GameSelector Games="@AllGames"
                              SelectedGameId="@CurrentGame.Id"
                              OnGameSelected="HandleGameSelected" />
            </section>

            <!-- 2. THEMATIC GAME HERO & PUBLIC SOURCE DATA -->
            <section class="section-block">
                <ThematicGameHero Game="@CurrentGame" />
            </section>

            <!-- 3. CONFIGURATION & SCHEDULE FORM -->
            <section class="section-block">
                <div class="section-badge-title mb-3">
                    <span class="step-badge">@Loc.Get("App.StepBadge", 2)</span> @Loc["App.Step2Title"]
                </div>
                <PlannerForm Game="@CurrentGame"
                             Input="@PlannerInput"
                             OnInputChanged="Recalculate" />
            </section>

            <!-- 4. RESULTS DASHBOARD (CARDS & PROGRESS) -->
            <section class="section-block">
                <div class="section-badge-title mb-3">
                    <span class="step-badge">@Loc.Get("App.StepBadge", 3)</span> @Loc["App.Step3Title"]
                </div>
                @if (CurrentResult != null)
                {
                    <CalculationSummaryCards Result="@CurrentResult" />
                }
            </section>

            <!-- 5. THEMATIC ROADMAP PROGRESSION -->
            <section class="section-block">
                @if (CurrentResult != null)
                {
                    <ThematicRoadmap Game="@CurrentGame" Result="@CurrentResult" />
                }
            </section>

            <!-- 6. CALENDAR TIMELINE & EXPORT -->
            <section class="section-block">
                @if (CurrentResult != null)
                {
                    <SessionsTimeline Result="@CurrentResult" />
                }
            </section>
        </div>
    }
    else
    {
        <div class="container text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }

    <footer class="app-footer py-4 text-center border-top">
        <div class="container">
            <div class="small text-muted mb-1">
                @Loc["App.FooterText"]
            </div>
            <div class="small text-muted-light">
                @Loc["App.FooterSources"]
            </div>
        </div>
    </footer>
</div>

@code {
    private IReadOnlyList<BoardGame> AllGames = new List<BoardGame>();
    private BoardGame? CurrentGame;
    private PlannerInputModel PlannerInput = new();
    private CalculationResult? CurrentResult;

    private string ThemeClass => CurrentGame?.Theme.ActiveThemeClass ?? "theme-gloomhaven-active";
    private bool HasBackgroundImage => !string.IsNullOrEmpty(CurrentGame?.BackgroundImageUrl);
    private string BackgroundImageStyle => HasBackgroundImage
        ? $"background-image: url('{CurrentGame!.BackgroundImageUrl}');"
        : string.Empty;

    protected override void OnInitialized()
    {
        LocService.OnLanguageChanged += HandleLanguageChanged;
        LoadGameData();
    }

    private void LoadGameData()
    {
        var currentLang = LocService.CurrentLanguage;
        AllGames = DataService.GetAllGames(currentLang);
        CurrentGame = DataService.GetGame(PlannerInput.SelectedGameId, currentLang);
        
        if (CurrentGame != null)
        {
            PlannerInput.SelectedGameId = CurrentGame.Id;
            if (string.IsNullOrEmpty(PlannerInput.SelectedScopeId) || !CurrentGame.Scopes.Any(s => s.Id == PlannerInput.SelectedScopeId))
            {
                var recScope = CurrentGame.Scopes.FirstOrDefault(s => s.IsRecommended) ?? CurrentGame.Scopes.FirstOrDefault();
                if (recScope != null)
                {
                    PlannerInput.SelectedScopeId = recScope.Id;
                }
            }

            Recalculate();
        }
    }

    private void HandleLanguageChanged()
    {
        LoadGameData();
        InvokeAsync(StateHasChanged);
    }

    private void HandleGameSelected(string gameId)
    {
        if (CurrentGame?.Id != gameId)
        {
            CurrentGame = DataService.GetGame(gameId, LocService.CurrentLanguage);
            PlannerInput.SelectedGameId = gameId;
            if (CurrentGame != null)
            {
                var recScope = CurrentGame.Scopes.FirstOrDefault(s => s.IsRecommended) ?? CurrentGame.Scopes.FirstOrDefault();
                if (recScope != null)
                {
                    PlannerInput.SelectedScopeId = recScope.Id;
                }
            }
            Recalculate();
        }
    }

    private void Recalculate()
    {
        if (CurrentGame != null)
        {
            CurrentResult = CalculatorService.Calculate(PlannerInput, CurrentGame, Loc);
        }
    }

    public void Dispose()
    {
        LocService.OnLanguageChanged -= HandleLanguageChanged;
    }
}
