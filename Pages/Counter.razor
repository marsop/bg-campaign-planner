@page "/counter"
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Counter.Title"]</PageTitle>

<h1>@Loc["Counter.Title"]</h1>

<p role="status">@Loc.Get("Counter.CurrentCount", currentCount)</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Loc["Counter.ClickMe"]</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
