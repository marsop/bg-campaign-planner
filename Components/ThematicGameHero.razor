@using bg_campaign_planner.Models
@using bg_campaign_planner.Services
@inject IStringLocalizer<AppResources> Loc

<div class="thematic-hero-wrapper mb-4">
    <div class="thematic-hero-card @Game.Theme.HeroClass">
        <div class="hero-texture-overlay"></div>
        <div class="hero-content">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="hero-badge-strip mb-2">
                        <span class="hero-badge">@Game.Theme.BadgeCategory</span>
                        <span class="hero-badge-sub">@Game.Designers • @Game.ReleaseYear</span>
                        <span class="hero-badge-tagline">@Game.Theme.Tagline</span>
                    </div>

                    <div class="hero-identity-header d-flex align-items-center gap-3 gap-md-4 mb-3">
                        @if (!string.IsNullOrEmpty(Game.ImageUrl))
                        {
                            <div class="hero-cover-box flex-shrink-0">
                                <img src="@Game.ImageUrl" alt="@Game.Title" class="hero-cover-img" />
                            </div>
                        }
                        <div class="hero-identity-text flex-grow-1 min-w-0">
                            <h1 class="hero-main-title mb-1">@Game.Title</h1>
                            <p class="hero-main-subtitle mb-0">@Game.Subtitle</p>
                        </div>
                    </div>

                    <div class="hero-lore-box mb-3">
                        <div class="lore-icon">
                            <span>@Game.Theme.LoreIcon</span>
                        </div>
                        <div class="lore-text">
                            @Game.Theme.LoreSummary
                        </div>
                    </div>

                </div>

                <div class="col-lg-4 mt-3 mt-lg-0">
                    <div class="hero-side-panel">
                        <div class="panel-header">
                            <i class="bi bi-info-circle me-1"></i> @Loc["Hero.PublicDataRef"]
                        </div>
                        <div class="panel-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted-light">@Loc["Hero.BggRating"]</span>
                                @if (!string.IsNullOrEmpty(Game.BggUrl))
                                {
                                    <a href="@Game.BggUrl" target="_blank" rel="noopener noreferrer" class="fw-bold text-highlight bgg-link-highlight" title="@Loc.Get("Hero.OpenOnBgg", Game.Title)">
                                        ⭐ @Game.BggRating.ToString("F1", CultureInfo.CurrentCulture) / 10 <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.75rem;"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-bold text-highlight">⭐ @Game.BggRating.ToString("F1", CultureInfo.CurrentCulture) / 10</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted-light">@Loc["Hero.ComplexityRating"]</span>
                                <span class="fw-bold text-highlight">🧠 @Game.BggWeight.ToString("F2", CultureInfo.CurrentCulture) / 5.0</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted-light">@Loc["Hero.Players"]</span>
                                <span class="fw-bold text-highlight">👥 @(Game.PlayersMin == Game.PlayersMax ? $"{Game.PlayersMin}" : $"{Game.PlayersMin}–{Game.PlayersMax}")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted-light">@Loc["Hero.AvgPlay"]</span>
                                <span class="fw-bold text-highlight">⏱️ ~@Game.BaseScenarioMinutes @Loc["Hero.Mins"]</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted-light">@Loc["Hero.SetupTeardown"]</span>
                                <span class="fw-bold text-highlight">🛠️ ~@Game.SetupTeardownMinutes @Loc["Hero.Mins"]</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted-light">@Loc["Hero.Release"]</span>
                                <span class="fw-bold text-highlight">📅 @Game.ReleaseYear</span>
                            </div>

                            <hr class="panel-divider" />

                            <div class="source-references">
                                <div class="sources-title">@Loc["Hero.VerifiedSources"]</div>
                                <ul class="sources-list">
                                    @foreach (var src in Game.PublicSourceReferences)
                                    {
                                        @if (src.StartsWith("BoardGameGeek") && !string.IsNullOrEmpty(Game.BggUrl))
                                        {
                                            <li>
                                                <a href="@Game.BggUrl" target="_blank" rel="noopener noreferrer" class="bgg-source-link" title="@Loc.Get("Hero.OpenOnBgg", Game.Title)">
                                                    @src <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.7rem;"></i>
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>@src</li>
                                        }
                                    }
                                </ul>
                                @if (!string.IsNullOrEmpty(Game.BggUrl))
                                {
                                    <div class="mt-3">
                                        <a href="@Game.BggUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light w-100 bgg-hero-btn">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> @Loc["Hero.ViewOnBgg"]
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = null!;
}
