@inject IStringLocalizer<AppResources> Loc
@inject ILocalizationService LocService
@implements IDisposable

<div class="language-selector-wrapper d-inline-block position-relative">
    <button class="btn btn-sm btn-language-toggle d-flex align-items-center gap-1 @(isOpen ? "show" : "")"
            type="button"
            @onclick="ToggleDropdown"
            title="@Loc["Language.Select"]">
        <span class="lang-flag">@CurrentLanguageInfo?.Flag</span>
        <span class="lang-name d-none d-md-inline ms-1 small">@CurrentLanguageInfo?.Name</span>
        <span class="lang-code text-uppercase fw-semibold d-inline d-md-none">@LocService.CurrentLanguage</span>
        <i class="bi bi-chevron-down ms-1 small opacity-75"></i>
    </button>
    
    @if (isOpen)
    {
        <div class="language-dropdown-menu shadow-lg" @onclick:stopPropagation>
            <div class="dropdown-header small text-muted text-uppercase px-3 py-1">@Loc["Language.Select"]</div>
            @foreach (var lang in LocService.SupportedLanguages)
            {
                var isSelected = lang.Code.Equals(LocService.CurrentLanguage, StringComparison.OrdinalIgnoreCase);
                <button class="language-option-item d-flex align-items-center justify-content-between w-100 @(isSelected ? "active" : "")"
                        @onclick="() => SelectLanguage(lang.Code)">
                    <span class="d-flex align-items-center gap-2">
                        <span class="lang-item-flag">@lang.Flag</span>
                        <span class="lang-item-name">@lang.Name</span>
                    </span>
                    @if (isSelected)
                    {
                        <i class="bi bi-check-circle-fill text-warning"></i>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private bool isOpen = false;

    private LanguageInfo? CurrentLanguageInfo =>
        LocService.SupportedLanguages.FirstOrDefault(l => l.Code.Equals(LocService.CurrentLanguage, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        LocService.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private async Task SelectLanguage(string code)
    {
        isOpen = false;
        await LocService.SetLanguageAsync(code);
    }

    public void Dispose()
    {
        LocService.OnLanguageChanged -= HandleLanguageChanged;
    }
}
