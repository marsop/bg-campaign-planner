@using bg_campaign_planner.Models
@using bg_campaign_planner.Services
@using System.Globalization
@inject IStringLocalizer<AppResources> Loc

<div class="game-selector-container mb-4">
    <!-- FILTER BAR -->
    <div class="game-filter-bar mb-4">
        <div class="row g-3 align-items-center">
            <!-- Player Count Filter -->
            <div class="col-12 col-lg-5">
                <div class="filter-group">
                    <span class="filter-label">
                        <i class="bi bi-people-fill me-1"></i> @Loc["GameSelector.FilterPlayers"]:
                    </span>
                    <div class="filter-pills-group" role="group" aria-label="@Loc["GameSelector.FilterPlayers"]">
                        <button type="button" class="btn-filter-pill @(selectedPlayerCount == null ? "active" : "")"
                                @onclick="() => SetPlayerFilter(null)">
                            @Loc["GameSelector.FilterAll"]
                        </button>
                        @foreach (var count in AvailablePlayerCounts)
                        {
                            var c = count;
                            <button type="button" class="btn-filter-pill @(selectedPlayerCount == c ? "active" : "")"
                                    @onclick="() => SetPlayerFilter(c)">
                                @(c == 1 ? Loc["GameSelector.PlayerSolo"] : Loc.Get("GameSelector.PlayerCount", c))
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Weight / Complexity Filter -->
            <div class="col-12 col-lg-7">
                <div class="filter-group">
                    <span class="filter-label">
                        <i class="bi bi-speedometer2 me-1"></i> @Loc["GameSelector.FilterWeight"]:
                    </span>
                    <div class="filter-pills-group" role="group" aria-label="@Loc["GameSelector.FilterWeight"]">
                        <button type="button" class="btn-filter-pill @(selectedWeight == WeightFilter.All ? "active" : "")"
                                @onclick="() => SetWeightFilter(WeightFilter.All)">
                            @Loc["GameSelector.FilterAll"]
                        </button>
                        <button type="button" class="btn-filter-pill @(selectedWeight == WeightFilter.Light ? "active" : "")"
                                @onclick="() => SetWeightFilter(WeightFilter.Light)">
                            @Loc["GameSelector.WeightLight"]
                        </button>
                        <button type="button" class="btn-filter-pill @(selectedWeight == WeightFilter.Medium ? "active" : "")"
                                @onclick="() => SetWeightFilter(WeightFilter.Medium)">
                            @Loc["GameSelector.WeightMedium"]
                        </button>
                        <button type="button" class="btn-filter-pill @(selectedWeight == WeightFilter.MediumHeavy ? "active" : "")"
                                @onclick="() => SetWeightFilter(WeightFilter.MediumHeavy)">
                            @Loc["GameSelector.WeightMediumHeavy"]
                        </button>
                        <button type="button" class="btn-filter-pill @(selectedWeight == WeightFilter.Heavy ? "active" : "")"
                                @onclick="() => SetWeightFilter(WeightFilter.Heavy)">
                            @Loc["GameSelector.WeightHeavy"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (HasActiveFilters)
        {
            var currentFiltered = FilteredGames;
            <div class="filter-status-row">
                <span class="filter-count-badge small">
                    <i class="bi bi-funnel-fill me-1 text-warning"></i>
                    @Loc.Get("GameSelector.ShowingGamesCount", currentFiltered.Count, Games.Count)
                </span>
                <button type="button" class="filter-reset-link" @onclick="ResetFilters">
                    <i class="bi bi-x-circle me-1"></i> @Loc["GameSelector.ClearFilters"]
                </button>
            </div>
        }
    </div>

    @{
        var displayedGames = FilteredGames;
    }

    <!-- GAMES GRID -->
    <div class="row g-3 g-md-4 justify-content-center">
        @if (displayedGames.Count == 0)
        {
            <div class="col-12">
                <div class="empty-filter-card">
                    <div class="empty-filter-icon mb-2">🎲🔍</div>
                    <h4 class="empty-filter-title mb-2">@Loc["GameSelector.NoMatchesTitle"]</h4>
                    <p class="text-muted-light mb-4">@Loc["GameSelector.NoMatchesDesc"]</p>
                    <button type="button" class="btn btn-outline-warning" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> @Loc["GameSelector.ClearFilters"]
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var game in displayedGames)
            {
                var isSelected = SelectedGameId == game.Id;

                <div class="col-12 col-md-6" id="game-card-@game.Id">
                    <div class="game-selection-card @(isSelected ? "selected" : "") @game.Theme.ThemeClass"
                         @onclick="() => OnGameSelected.InvokeAsync(game.Id)"
                         role="button"
                         tabindex="0"
                         aria-pressed="@(isSelected ? "true" : "false")">
                        
                        <div class="card-glow"></div>
                        
                        <div class="card-header-badge d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-category">@game.Theme.BadgeCategory</span>
                                @if (!string.IsNullOrEmpty(game.BggUrl))
                                {
                                    <a href="@game.BggUrl" target="_blank" rel="noopener noreferrer" class="badge-bgg-link" title="@Loc.Get("GameSelector.ViewOnBgg", game.Title)" @onclick:stopPropagation="true">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>BGG
                                    </a>
                                }
                            </div>
                            <span class="badge-status">
                                @if (isSelected)
                                {
                                    <span class="selected-indicator"><i class="bi bi-check-circle-fill me-1"></i> @Loc["GameSelector.ActiveGame"]</span>
                                }
                                else
                                {
                                    <span class="select-prompt">@Loc["GameSelector.ClickToSelect"]</span>
                                }
                            </span>
                        </div>

                        <div class="game-card-body">
                            <div class="game-identity-header d-flex align-items-center gap-3 mb-3">
                                <div class="game-cover-box flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(game.ImageUrl))
                                    {
                                        <img src="@game.ImageUrl" alt="@game.Title" class="game-cover-img" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="emblem-icon">@game.Theme.Emblem</span>
                                    }
                                </div>
                                <div class="game-identity-text flex-grow-1 min-w-0">
                                    <h3 class="game-title mb-1">@game.Title</h3>
                                    <p class="game-subtitle mb-0">@game.Subtitle</p>
                                </div>
                            </div>

                            <div class="game-meta-pills mb-3">
                                <span class="meta-pill" title="@Loc["GameSelector.BggRatingTooltip"]">
                                    ⭐ <strong>@game.BggRating.ToString("F1", CultureInfo.CurrentCulture)</strong> / 10
                                </span>
                                <span class="meta-pill" title="@Loc["GameSelector.Weight"] (1-5)">
                                    🧠 @Loc["GameSelector.Weight"]: <strong>@game.BggWeight.ToString("F2", CultureInfo.CurrentCulture)</strong>
                                </span>
                                <span class="meta-pill" title="@Loc["GameSelector.Players"]">
                                    👥 <strong>@(game.PlayersMin)-@(game.PlayersMax)</strong> @Loc["GameSelector.Players"]
                                </span>
                                <span class="meta-pill" title="@Loc["GameSelector.Year"]">
                                    📅 <strong>@game.ReleaseYear</strong>
                                </span>
                            </div>

                            <p class="game-lore-snippet">
                                <em>"@game.Theme.LoreSummary"</em>
                            </p>

                            <div class="key-features-list">
                                @foreach (var feature in game.KeyFeatures.Take(2))
                                {
                                    <div class="feature-item">
                                        <span class="bullet">✦</span> @feature
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card-footer-action">
                            <button class="btn btn-select-game w-100 @(isSelected ? "btn-active" : "")">
                                @if (isSelected)
                                {
                                    <span><i class="bi bi-check-lg me-1"></i> @Loc["GameSelector.SelectedBtn"]</span>
                                }
                                else
                                {
                                    <span>@Loc.Get("GameSelector.SwitchBtn", game.Title)</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<BoardGame> Games { get; set; } = new List<BoardGame>();

    [Parameter]
    public string SelectedGameId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnGameSelected { get; set; }

    public enum WeightFilter
    {
        All,
        Light,       // < 3.0
        Medium,      // 3.0 .. 3.5
        MediumHeavy, // 3.5 .. 4.0
        Heavy        // 4.0+
    }

    private int? selectedPlayerCount = null;
    private WeightFilter selectedWeight = WeightFilter.All;

    private bool HasActiveFilters => selectedPlayerCount.HasValue || selectedWeight != WeightFilter.All;

    private IEnumerable<int> AvailablePlayerCounts
    {
        get
        {
            if (Games == null || !Games.Any()) yield break;
            var min = Games.Min(g => g.PlayersMin);
            var max = Games.Max(g => g.PlayersMax);
            for (int i = min; i <= max; i++)
            {
                yield return i;
            }
        }
    }

    private IReadOnlyList<BoardGame> FilteredGames
    {
        get
        {
            if (Games == null) return Array.Empty<BoardGame>();
            var query = Games.AsEnumerable();

            if (selectedPlayerCount.HasValue)
            {
                var target = selectedPlayerCount.Value;
                query = query.Where(g => g.PlayersMin <= target && target <= g.PlayersMax);
            }

            if (selectedWeight != WeightFilter.All)
            {
                query = selectedWeight switch
                {
                    WeightFilter.Light => query.Where(g => g.BggWeight < 3.0),
                    WeightFilter.Medium => query.Where(g => g.BggWeight >= 3.0 && g.BggWeight < 3.5),
                    WeightFilter.MediumHeavy => query.Where(g => g.BggWeight >= 3.5 && g.BggWeight < 4.0),
                    WeightFilter.Heavy => query.Where(g => g.BggWeight >= 4.0),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private async Task SetPlayerFilter(int? count)
    {
        selectedPlayerCount = count;
        await EnsureValidSelection();
    }

    private async Task SetWeightFilter(WeightFilter weight)
    {
        selectedWeight = weight;
        await EnsureValidSelection();
    }

    private async Task ResetFilters()
    {
        selectedPlayerCount = null;
        selectedWeight = WeightFilter.All;
        await EnsureValidSelection();
    }

    private async Task EnsureValidSelection()
    {
        var filtered = FilteredGames;
        if (!string.IsNullOrEmpty(SelectedGameId) && !filtered.Any(g => g.Id == SelectedGameId))
        {
            SelectedGameId = string.Empty;
            await OnGameSelected.InvokeAsync(string.Empty);
        }
    }
}
