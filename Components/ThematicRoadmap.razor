@using bg_campaign_planner.Models
@using bg_campaign_planner.Services
@inject IStringLocalizer<AppResources> Loc

<div class="thematic-roadmap-wrapper mb-4">
    <div class="roadmap-card @GetRoadmapClass(Game.Id)">
        <div class="roadmap-header d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="roadmap-title">
                    <span>@GetRoadmapTitle(Game.Id)</span>
                </h4>
                <div class="roadmap-subtitle">
                    @Loc["Roadmap.Subtitle"]
                </div>
            </div>
            <div class="badge-roadmap-style">
                <span>@GetRoadmapBadge(Game.Id)</span>
            </div>
        </div>

        <div class="milestones-timeline-container">
            <div class="milestones-track-line"></div>

            <div class="row g-3">
                @foreach (var proj in Result.MilestoneProjections)
                {
                    var m = proj.Milestone;
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="milestone-step-card">
                            <div class="milestone-step-top d-flex justify-content-between align-items-center mb-2">
                                <span class="step-num">@Loc.Get("Roadmap.Step", m.Order)</span>
                                <span class="badge-step">@m.BadgeText</span>
                            </div>

                            <div class="milestone-icon-circle mb-2">
                                <span class="milestone-emoji">@m.IconEmoji</span>
                            </div>

                            <h5 class="milestone-title">@m.Title</h5>
                            <div class="milestone-phase">@m.Phase</div>
                            <p class="milestone-desc">@m.Description</p>

                            <hr class="milestone-divider" />

                            <div class="milestone-forecast">
                                <div class="forecast-item">
                                    <span class="forecast-label">@Loc["Roadmap.MeetupTarget"]</span>
                                    <span class="forecast-val">#@proj.EstimatedMeetupNumber</span>
                                </div>
                                <div class="forecast-item">
                                    <span class="forecast-label">@Loc["Roadmap.Date"]</span>
                                    <span class="forecast-val">@proj.EstimatedDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</span>
                                </div>
                                <div class="forecast-item">
                                    <span class="forecast-label">@Loc["Roadmap.TableTime"]</span>
                                    <span class="forecast-val">@Loc.Get("Roadmap.HoursSpent", proj.HoursSpentUntilMilestone.ToString("F0", CultureInfo.CurrentCulture))</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = null!;

    [Parameter, EditorRequired]
    public CalculationResult Result { get; set; } = null!;

    private string GetRoadmapClass(GameId id) => id switch
    {
        GameId.Gloomhaven => "roadmap-gloomhaven",
        GameId.Frosthaven => "roadmap-frosthaven",
        GameId.PandemicSeason0 => "roadmap-pandemic",
        GameId.SleepingGods => "roadmap-sleepinggods",
        GameId.Oathsworn => "roadmap-oathsworn",
        GameId.TaintedGrailFallOfAvalon => "roadmap-taintedgrail",
        _ => "roadmap-gloomhaven"
    };

    private string GetRoadmapTitle(GameId id) => id switch
    {
        GameId.Gloomhaven => Loc["Roadmap.GloomhavenTitle"],
        GameId.Frosthaven => Loc["Roadmap.FrosthavenTitle"],
        GameId.PandemicSeason0 => Loc["Roadmap.PandemicTitle"],
        GameId.SleepingGods => Loc["Roadmap.SleepingGodsTitle"],
        GameId.Oathsworn => Loc["Roadmap.OathswornTitle"],
        GameId.TaintedGrailFallOfAvalon => Loc["Roadmap.TaintedGrailTitle"],
        _ => Loc["Roadmap.GloomhavenTitle"]
    };

    private string GetRoadmapBadge(GameId id) => id switch
    {
        GameId.Gloomhaven => Loc["Roadmap.GloomhavenBadge"],
        GameId.Frosthaven => Loc["Roadmap.FrosthavenBadge"],
        GameId.PandemicSeason0 => Loc["Roadmap.PandemicBadge"],
        GameId.SleepingGods => Loc["Roadmap.SleepingGodsBadge"],
        GameId.Oathsworn => Loc["Roadmap.OathswornBadge"],
        GameId.TaintedGrailFallOfAvalon => Loc["Roadmap.TaintedGrailBadge"],
        _ => Loc["Roadmap.GloomhavenBadge"]
    };
}
