@using bg_campaign_planner.Models
@using bg_campaign_planner.Services
@inject PlannerCalculatorService CalculatorService
@inject IStringLocalizer<AppResources> Loc
@inject IJSRuntime JS

<div class="sessions-timeline-card mb-5">
    <div class="timeline-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h4 class="timeline-title"><i class="bi bi-calendar3 me-2"></i> @Loc["Timeline.Title"]</h4>
            <div class="timeline-subtitle">@Loc.Get("Timeline.Subtitle", Result.Sessions.Count)</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary btn-sm btn-export" @onclick="ExportCalendarIcs">
                <i class="bi bi-download me-1"></i> @Loc["Timeline.ExportBtn"]
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div class="alert alert-success alert-dismissible py-2 small mb-3">
            @ToastMessage
            <button type="button" class="btn-close btn-close-white small p-2" @onclick="() => ToastMessage = null"></button>
        </div>
    }

    <!-- FILTER / SEARCH & VIEW TOGGLE -->
    <div class="timeline-controls d-flex justify-content-between align-items-center mb-3">
        @if (Result.MilestoneProjections.Any())
        {
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted">@Loc["Timeline.Showing"]</span>
                <button class="btn btn-xs @(ShowOnlyMilestones ? "btn-secondary" : "btn-primary")"
                        @onclick="() => ShowOnlyMilestones = false">
                    @Loc.Get("Timeline.AllSessions", Result.Sessions.Count)
                </button>
                <button class="btn btn-xs @(ShowOnlyMilestones ? "btn-primary" : "btn-secondary")"
                        @onclick="() => ShowOnlyMilestones = true">
                    @Loc.Get("Timeline.MilestoneSessions", Result.Sessions.Count(s => s.IsMilestoneSession))
                </button>
            </div>
        }
        else
        {
            <div></div>
        }

        <div class="small text-muted">
            @Loc.Get("Timeline.PageOf", CurrentPage, TotalPages)
        </div>
    </div>

    <!-- SESSIONS LIST (MOBILE PHONES < 576px) -->
    <div class="sessions-mobile-list d-block d-sm-none">
        @foreach (var session in DisplayedSessions)
        {
            var isMilestone = IsSessionMilestone(session);
            <div class="session-mobile-card p-3 rounded mb-2 @(isMilestone ? "milestone-mobile-card" : "")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(isMilestone ? "bg-warning text-dark" : "bg-secondary") fw-bold">
                            #@session.SessionNumber
                        </span>
                        <span class="fw-bold text-main small">@session.Date.ToString("ddd, MMM d, yyyy", CultureInfo.CurrentCulture)</span>
                    </div>
                    <span class="text-info small fw-semibold">
                        <i class="bi bi-clock me-1"></i>@session.EstimatedSessionHours.ToString("F1", CultureInfo.CurrentCulture) @Loc["Kpi.HoursUnit"]
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center text-muted small mb-1">
                    <span>
                        <i class="bi bi-hourglass-split me-1"></i>@session.StartDateTime.ToString("t", CultureInfo.CurrentCulture) - @session.EndDateTime.ToString("t", CultureInfo.CurrentCulture)
                    </span>
                    <span class="badge scenario-range-badge border">
                        @(session.StartScenarioIndex == session.EndScenarioIndex 
                            ? $"{session.StartScenarioIndex}" 
                            : $"{session.StartScenarioIndex} – {session.EndScenarioIndex}")
                        <span class="ms-1 opacity-75">(@session.ScenariosPlayedInSession)</span>
                    </span>
                </div>

                @if (isMilestone)
                {
                    <div class="milestone-mobile-badge mt-2 pt-2 border-top border-secondary border-opacity-25 d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark flex-shrink-0">@Loc["Timeline.MilestoneBadge"]</span>
                        <div class="text-truncate">
                            @if (ShowSpoilers && !string.IsNullOrEmpty(session.CampaignMilestoneNote ?? session.MilestoneNote))
                            {
                                <strong class="milestone-note-text small">@(session.CampaignMilestoneNote ?? session.MilestoneNote)</strong>
                                var phase = session.CampaignMilestonePhase ?? session.MilestonePhase;
                                if (!string.IsNullOrEmpty(phase))
                                {
                                    <span class="small text-muted ms-1">(@phase)</span>
                                }
                            }
                            else
                            {
                                <strong class="milestone-note-text small">@Loc["Timeline.HiddenMilestoneNote"] #@(session.GenericMilestoneOrder ?? session.MilestoneOrder ?? 1)</strong>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- SESSIONS TABLE (DESKTOP & TABLETS >= 576px) -->
    <div class="table-responsive sessions-table-wrapper d-none d-sm-block">
        <table class="table table-hover table-dark-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 70px;">@Loc["Timeline.ColNumber"]</th>
                    <th style="width: 160px;">@Loc["Timeline.ColDateDay"]</th>
                    <th style="width: 140px;">@(Result.Game.UnitType != "games_months" ? Loc["Timeline.ColScenarios"] : Loc["Timeline.ColGames"])</th>
                    <th style="width: 110px;">@Loc["Timeline.ColHours"]</th>
                    <th>@Loc["Timeline.ColMilestoneNote"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in DisplayedSessions)
                {
                    <tr class="@(IsSessionMilestone(session) ? "table-row-milestone" : "")">
                        <td>
                            <span class="badge @(IsSessionMilestone(session) ? "bg-warning text-dark" : "bg-secondary")">
                                #@session.SessionNumber
                            </span>
                        </td>
                        <td>
                            <div class="fw-bold">@session.Date.ToString("ddd, MMM d, yyyy", CultureInfo.CurrentCulture)</div>
                            <div class="small text-muted">@session.StartDateTime.ToString("t", CultureInfo.CurrentCulture) - @session.EndDateTime.ToString("t", CultureInfo.CurrentCulture)</div>
                        </td>
                        <td>
                            <span class="badge scenario-range-badge border">
                                @(session.StartScenarioIndex == session.EndScenarioIndex 
                                    ? $"{session.StartScenarioIndex}" 
                                    : $"{session.StartScenarioIndex} – {session.EndScenarioIndex}")
                            </span>
                            <span class="small text-muted ms-1">(@session.ScenariosPlayedInSession)</span>
                        </td>
                        <td>
                            <span class="text-info fw-semibold">@session.EstimatedSessionHours.ToString("F1", CultureInfo.CurrentCulture) @Loc["Kpi.HoursUnit"]</span>
                        </td>
                        <td>
                            @if (IsSessionMilestone(session))
                            {
                                <div class="milestone-table-tag">
                                    <span class="badge bg-warning text-dark me-1">@Loc["Timeline.MilestoneBadge"]</span>
                                    @if (ShowSpoilers && !string.IsNullOrEmpty(session.CampaignMilestoneNote ?? session.MilestoneNote))
                                    {
                                        <strong class="milestone-note-text">@(session.CampaignMilestoneNote ?? session.MilestoneNote)</strong>
                                        var phase = session.CampaignMilestonePhase ?? session.MilestonePhase;
                                        if (!string.IsNullOrEmpty(phase))
                                        {
                                            <span class="small text-muted ms-1">(@phase)</span>
                                        }
                                    }
                                    else
                                    {
                                        <strong class="milestone-note-text">@Loc["Timeline.HiddenMilestoneNote"] #@(session.GenericMilestoneOrder ?? session.MilestoneOrder ?? 1)</strong>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">@Loc["Timeline.StandardSession"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    @if (TotalPages > 1)
    {
        <!-- Mobile Compact Pagination (< 576px) -->
        <div class="d-flex d-sm-none justify-content-between align-items-center mt-3 pt-2 border-top border-secondary border-opacity-10">
            <button class="btn btn-sm btn-outline-secondary px-3"
                    disabled="@(CurrentPage <= 1)"
                    @onclick="() => CurrentPage--">
                <i class="bi bi-chevron-left me-1"></i>@Loc["Timeline.PrevBtn"]
            </button>
            <span class="small fw-semibold text-muted-light">
                @CurrentPage / @TotalPages
            </span>
            <button class="btn btn-sm btn-outline-secondary px-3"
                    disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => CurrentPage++">
                @Loc["Timeline.NextBtn"]<i class="bi bi-chevron-right ms-1"></i>
            </button>
        </div>

        <!-- Desktop Pagination (>= 576px) -->
        <div class="d-none d-sm-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(CurrentPage <= 1)"
                    @onclick="() => CurrentPage--">
                @Loc["Timeline.PrevBtn"]
            </button>
            <div class="d-flex gap-1">
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNum = i;
                    <button class="btn btn-xs @(CurrentPage == pageNum ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => CurrentPage = pageNum">
                        @pageNum
                    </button>
                }
            </div>
            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => CurrentPage++">
                @Loc["Timeline.NextBtn"]
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CalculationResult Result { get; set; } = null!;

    [Parameter]
    public bool ShowSpoilers { get; set; } = false;

    private bool ShowOnlyMilestones = false;
    private int CurrentPage = 1;
    private const int PageSize = 10;
    private string? ToastMessage;

    private bool IsSessionMilestone(ScheduledSession session)
    {
        if (ShowSpoilers && Result.CampaignMilestoneProjections.Any())
        {
            return session.CampaignMilestoneOrder != null;
        }
        return session.GenericMilestoneOrder != null || session.IsMilestoneSession;
    }

    private IEnumerable<ScheduledSession> FilteredSessions =>
        ShowOnlyMilestones ? Result.Sessions.Where(IsSessionMilestone) : Result.Sessions;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredSessions.Count() / PageSize));

    private IEnumerable<ScheduledSession> DisplayedSessions =>
        FilteredSessions.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    protected override void OnParametersSet()
    {
        CurrentPage = 1;
    }

    private async Task ExportCalendarIcs()
    {
        var icsContent = CalculatorService.GenerateIcsFile(Result, Loc, ShowSpoilers);
        var filename = $"{Result.Game.Id}-Campaign-Schedule.ics";
        await JS.InvokeVoidAsync("campaignPlanner.downloadFile", filename, "text/calendar", icsContent);
        ToastMessage = Loc.Get("Timeline.IcsToast", filename);
    }
}
